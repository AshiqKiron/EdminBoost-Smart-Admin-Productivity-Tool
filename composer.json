{
	"name": "asphaltthemes/edminboost",
	"description": "EdminBoost WordPress plugin dev dependencies",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "^6.7",
		"wp-cli/i18n-command": "^2.7"
	},
	"scripts": {
		"test": "bash bin/run-phpunit.sh",
		"test:install": "bash bin/install-wp-tests.sh",
		"make-pot": "bash bin/make-pot.sh",
		"build:wporg": "bash bin/build-wporg-zip.sh",
		"build:premium": "bash bin/build-premium-zip.sh"
	},
	"config": {
		"allow-plugins": {
			"yoast/phpunit-polyfills": true
		}
	},
	"autoload-dev": {
		"classmap": [
			"tests/phpunit/"
		]
	}
}
